# Local development values only. The moment a real secret lands in here, move
# this file to .gitignore and check in a .env.example in its place.

PORT=5000
NODE_ENV=development

# DB_PORT is the HOST side of the docker-compose port mapping (5433:5432).
DB_HOST=localhost
DB_PORT=5433
DB_USER=waypoint_user
DB_PASSWORD=waypoint_password
DB_NAME=dracarys_waypoint

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

CACHE_TTL_SECONDS=60

# The dispatcher logs in with the phone number.
SYSTEM_DISPATCHER_PASSWORD=111111
SYSTEM_DISPATCHER_PHONE=0770000000

# Optional demo store manager, linked to outlet OUT001. Leave the password
# unset to skip seeding it.
DEMO_STORE_MANAGER_PASSWORD=111111
DEMO_STORE_MANAGER_PHONE=0770000001

# Optional demo driver (put on the first free Peliyagoda vehicle) and loader.
# Leave a password unset to skip seeding that account.
DEMO_DRIVER_PASSWORD=111111
DEMO_DRIVER_PHONE=0770000002
DEMO_LOADER_PASSWORD=111111
DEMO_LOADER_PHONE=0770000003

# Cloudinary account that stores every uploaded image (profile pictures,
# proof-of-delivery signatures and photos, issue photos). Without these the
# API still runs; POST /api/images answers 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The OSRM routing engine (see osrm_setup/), which /api/routing/route proxies.
OSRM_URL=http://localhost:8081

# SMS Gateway (smsapi.lk) configuration
SMS_API_URL=https://dashboard.smsapi.lk/api/v3/sms/send
SMS_API_KEY=292|WPxu00nBvbZiPWylMIaf583XXniSE810eZKQpqT4 
SMS_SENDER_ID=SMSAPI Demo
OTP_EXPIRE_MINUTES=10

# RabbitMQ (docker-compose `rabbitmq` service). SMS is queued here and sent by
# SmsConsumer; driver position fixes are queued on their own queue and stored
# by VehicleLocationsConsumer.
RABBITMQ_URL=amqp://waypoint_user:waypoint_password@localhost:5672
SMS_QUEUE=sms_queue
LOCATION_QUEUE=vehicle_location_queue
