# Local development values only. The moment a real secret lands in here, move
# this file to .gitignore and check in a .env.example in its place.

PORT=5000
NODE_ENV=development

# DB_PORT is the HOST side of the docker-compose port mapping (5433:5432).
DB_HOST=localhost
DB_PORT=5433
DB_USER=waypoint_user
DB_PASSWORD=waypoint_password
DB_NAME=dracarys_waypoint

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

CACHE_TTL_SECONDS=60

# Consumed by the SeedSystemDispatcher migration, which throws if either is unset.
SYSTEM_DISPATCHER_EMAIL=dispatcher@waypoint.local
SYSTEM_DISPATCHER_PASSWORD=111111
SYSTEM_DISPATCHER_PHONE=0770000000

# SMS Gateway (smsapi.lk) configuration
SMS_API_URL=https://dashboard.smsapi.lk/api/v3/sms/send
SMS_API_KEY=292|WPxu00nBvbZiPWylMIaf583XXniSE810eZKQpqT4 
SMS_SENDER_ID=SMSAPI Demo
OTP_EXPIRE_MINUTES=10

# RabbitMQ (docker-compose `rabbitmq` service). SMS is queued here and sent by SmsConsumer.
RABBITMQ_URL=amqp://waypoint_user:waypoint_password@localhost:5672
SMS_QUEUE=sms_queue
