meta {
  name: 03-filter-by-depot
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/api/vehicles?depot=Peliyagoda&limit=50
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.data.meta.total: eq 38
  res.body.data.items.length: eq 38
  res.body.data.items[0].depot.name: eq Peliyagoda
}
