meta {
  name: 04-filter-by-type
  type: http
  seq: 4
}

get {
  url: {{baseURL}}/api/vehicles?type=van&limit=20
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.data.meta.total: eq 8
  res.body.data.items.length: eq 8
  res.body.data.items[0].type: eq van
}
