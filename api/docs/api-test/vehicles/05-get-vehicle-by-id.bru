meta {
  name: 05-get-vehicle-by-id
  type: http
  seq: 5
}

get {
  url: {{baseURL}}/api/vehicles/VEH001
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.data.vehicleId: eq VEH001
  res.body.data.depot: eq Peliyagoda
  res.body.data.type: eq truck
  res.body.data.temp: eq reefer
  res.body.data.weightCapKg: eq 5510
}
