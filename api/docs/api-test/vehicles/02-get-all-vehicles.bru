meta {
  name: 02-get-all-vehicles
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/api/vehicles?limit=100
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.data.meta.total: eq 60
  res.body.data.items: isDefined
  res.body.data.items.length: eq 60
}
