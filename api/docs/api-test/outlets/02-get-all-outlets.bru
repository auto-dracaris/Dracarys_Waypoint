meta {
  name: 02-get-all-outlets
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/api/outlets?limit=100
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.data.meta.total: eq 120
  res.body.data.meta.page: eq 1
  res.body.data.meta.limit: eq 100
  res.body.data.meta.totalPages: eq 2
  res.body.data.items: isDefined
  res.body.data.items.length: eq 100
}
