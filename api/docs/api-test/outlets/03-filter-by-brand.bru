meta {
  name: 03-filter-by-brand
  type: http
  seq: 3
}

get {
  url: {{baseURL}}/api/outlets?brand=Fresh&limit=100
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.data.meta.total: eq 80
  res.body.data.items.length: eq 80
  res.body.data.items[0].brand: eq Fresh
}
