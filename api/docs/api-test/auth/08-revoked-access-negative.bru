meta {
  name: 08-revoked-access-negative
  type: http
  seq: 8
}

get {
  url: {{baseURL}}/api/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{rotated_access_token}}
}

docs {
  The access token is still within its expiry window, but 07-logout revoked the
  session it was issued under — the stateful check must reject it.
}

assert {
  res.status: eq 401
  res.body.message: eq Session has been revoked
}
