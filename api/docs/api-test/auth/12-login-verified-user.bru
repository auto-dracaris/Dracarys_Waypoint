meta {
  name: 12-login-verified-user
  type: http
  seq: 12
}

post {
  url: {{baseURL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "0771234567",
    "password": "Password123!"
  }
}

assert {
  res.status: eq 200
  res.body.data.accessToken: isDefined
  res.body.data.refreshToken: isDefined
  res.body.data.user.role: eq driver
  res.body.data.user.status: eq active
}
