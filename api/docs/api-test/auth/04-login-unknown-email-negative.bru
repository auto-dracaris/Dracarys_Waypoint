meta {
  name: 04-login-unknown-phone-negative
  type: http
  seq: 4
}

post {
  url: {{baseURL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "phone": "0779999999",
    "password": "{{system_dispatcher_password}}"
  }
}

docs {
  The message must be identical to a wrong-password failure, so the endpoint
  cannot be used to enumerate accounts.
}

assert {
  res.status: eq 401
  res.body.message: eq Invalid phone number or password
}
