meta {
  name: 03-update-me
  type: http
  seq: 3
}

put {
  url: {{baseURL}}/api/auth/me
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "name": "System Dispatcher (updated)"
  }
}

assert {
  res.status: eq 200
  res.body.data.name: eq System Dispatcher (updated)
}
