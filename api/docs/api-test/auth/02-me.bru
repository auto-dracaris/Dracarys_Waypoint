meta {
  name: 02-me
  type: http
  seq: 2
}

get {
  url: {{baseURL}}/api/auth/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.data.email: eq {{system_dispatcher_email}}
  res.body.data.role: eq dispatcher
  res.body.data.password: isUndefined
}
