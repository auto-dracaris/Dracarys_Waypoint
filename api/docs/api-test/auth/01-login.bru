meta {
  name: 01-login
  type: http
  seq: 1
}

post {
  url: {{baseURL}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{system_dispatcher_email}}",
    "password": "{{system_dispatcher_password}}"
  }
}

vars:post-response {
  access_token: res.body.data.accessToken
  refresh_token: res.body.data.refreshToken
}

assert {
  res.status: eq 200
  res.body.data.accessToken: isDefined
  res.body.data.refreshToken: isDefined
  res.body.data.user.password: isUndefined
}
