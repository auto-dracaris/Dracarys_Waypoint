meta {
  name: 16-change-password-revert
  type: http
  seq: 16
}

put {
  url: {{baseURL}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "currentPassword": "NewPassword123!",
    "newPassword": "Password123!"
  }
}

assert {
  res.status: eq 200
  res.body.message: eq Password changed successfully
}
