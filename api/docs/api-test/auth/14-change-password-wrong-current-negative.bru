meta {
  name: 14-change-password-wrong-current-negative
  type: http
  seq: 14
}

put {
  url: {{baseURL}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "currentPassword": "WrongPassword999!",
    "newPassword": "NewPassword123!"
  }
}

assert {
  res.status: eq 400
  res.body.message: eq Current password is incorrect
}
