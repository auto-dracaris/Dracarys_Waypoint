meta {
  name: 15-change-password
  type: http
  seq: 15
}

put {
  url: {{baseURL}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "currentPassword": "Password123!",
    "newPassword": "NewPassword123!"
  }
}

assert {
  res.status: eq 200
  res.body.message: eq Password changed successfully
}
