AI_ENVIRONMENT=development
# Local document-only chat may bypass identity; production rejects false.
# Business chat and document management always require verified NestJS tokens.
AI_AUTH_ENABLED=false
AI_DEVELOPMENT_ROLE=store_manager
AI_LOG_LEVEL=INFO
# Browser origins as a JSON array. Empty by default for server-to-server access.
AI_CORS_ORIGINS=[]
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_AGENT_STEPS=8

# Optional at startup; protected chat requires NestJS authentication and PostgreSQL.
AI_NESTJS_BASE_URL=http://localhost:5000/api
AI_QDRANT_URL=http://localhost:6333
AI_QDRANT_API_KEY=
AI_QDRANT_COLLECTION=waypoint_knowledge_hybrid_v1
AI_GEMINI_API_KEY=
# Leave blank for recorded-reason answers without policy retrieval/model explanation.
AI_GEMINI_MODEL=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=768
# Character counts, not token counts. Overlap must be less than half the size.
AI_CHUNK_SIZE=1200
AI_CHUNK_OVERLAP=150
# Plain psycopg DSN: postgresql://waypoint_ai:PASSWORD@localhost:5434/waypoint_ai
AI_DATABASE_URL=
# Originals are private files shared by the API and ingestion worker.
AI_DOCUMENT_STORAGE_PATH=data/documents
AI_INGESTION_TIMEOUT_SECONDS=300
AI_WORKER_POLL_SECONDS=2
AI_WORKER_MAX_ATTEMPTS=3
# Leave blank until NestJS implements docs/business-api-contract.md.
# Value must be a relative path template containing {order_id}.
AI_DEFERRAL_ENDPOINT=
