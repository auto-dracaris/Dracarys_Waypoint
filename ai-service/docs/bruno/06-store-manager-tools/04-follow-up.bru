meta {
  name: Chat: Business order follow-up
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/v1/chat
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chat_token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "Show the latest status of the same order",
    "workflow": "business_qa",
    "conversation_id": "{{conversation_id}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("conversation_id", res.getBody().conversation_id);
  }
}

assert {
  res.status: eq 200
  res.body.conversation_id: isDefined
  res.body.answer: isDefined
  res.body.sources: isDefined
}

docs {
  Requires a verified store-manager access token in the secret chat_token variable.
  Business tools require authentication even when local document authentication is disabled.
  For details, set order_id to an actual order owned by this manager.
  For follow-up, send Order details first to establish the last order in this conversation.
}
