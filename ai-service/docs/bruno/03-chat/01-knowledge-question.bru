meta {
  name: Chat: Knowledge question
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "message": "{{question}}",
    "workflow": "knowledge_qa"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("conversation_id", res.getBody().conversation_id);
  }
}

assert {
  res.status: eq 200
  res.body.conversation_id: isDefined
  res.body.answer: isDefined
  res.body.status: isDefined
}

