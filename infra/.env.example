# Run setup.ps1 to generate an ignored .env with independent local credentials.
# These placeholders are not credentials to use as-is.
AI_POSTGRES_PASSWORD=__GENERATE_AI_POSTGRES_PASSWORD__
QDRANT_API_KEY=__GENERATE_QDRANT_API_KEY__
GRAFANA_ADMIN_PASSWORD=__GENERATE_GRAFANA_ADMIN_PASSWORD__

# Ports are bound to this computer only; change here if a port is occupied.
AI_POSTGRES_PORT=5434
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
TEMPO_HTTP_PORT=3200
GRAFANA_PORT=3001

# Explicit release tags for supporting services. PostgreSQL follows the existing major.
POSTGRES_IMAGE=postgres:16
QDRANT_IMAGE=qdrant/qdrant:v1.19.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.161.0
TEMPO_IMAGE=grafana/tempo:3.1.0
GRAFANA_IMAGE=grafana/grafana:13.2.3
